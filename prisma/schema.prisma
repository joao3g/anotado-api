// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

model User {
    id       String  @id @default(uuid())
    name     String?
    email    String? @unique
    login    String @unique
    password String
    phone    String? // Brazilian phone, digits only (10 or 11 digits with area code)
    avatar   String? // Profile photo as "data:image/jpeg;base64,..." (resized to 256x256 by the browser, max 90,000 chars)

	group Group? @relation(fields: [groupId], references: [id])
	groupId String?
	// Role inside the family. MEMBER when joining with an invite code, ADMIN when creating the family.
	// Back to MEMBER when leaving or being removed. Every family with members keeps at least one ADMIN.
	role GroupRole @default(MEMBER)

	// WhatsApp id (wa_id, digits with country code) linked with a one-time code sent to the bot. Never guessed from phone.
	whatsappId String? @unique
	whatsappLinkCode WhatsappLinkCode?
	whatsappDraft WhatsappDraft?

	incomes Income[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum GroupRole {
	ADMIN
	MEMBER
}

model Group {
	id String @id @default(uuid())
	title String
	description String?
	inviteCode String @unique // 8 chars from ABCDEFGHJKLMNPQRSTUVWXYZ23456789. New users join the family with it.
	
	users User[]
	categories Category[]
	expenses Expense[]
	incomes Income[]
	recurrences Recurrence[]
	cards Card[]

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

	@@index([title])
}

model Category {
	id String @id @default(uuid())
	title String
	description String?
	color String

	expenses Expense[]
	recurrences Recurrence[]

	group Group @relation(fields: [groupId], references: [id])
	groupId String

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

	@@index([groupId, title])
}

// Credit card of a group. Every CREDIT expense and recurrence has one (database CHECK constraint).
model Card {
	id String @id @default(uuid())
	title String
	lastFourDigits String? // Exactly 4 digits, as a string to keep leading zeros. Never a full card number.
	color String @default("009A4D") // Hex WITHOUT "#", exactly 6 chars (same format as Category.color)
	closingDay Int // 1..27 (invoice day 2..28 exists in every month). dueDate of a CREDIT expense = the day after this, in the next invoice.

	expenses Expense[]
	recurrences Recurrence[]

	group Group @relation(fields: [groupId], references: [id])
	groupId String

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

	@@index([groupId])
}

enum PaymentMethod {
	DEBIT
	CREDIT
	VOUCHER
}

model Expense {
	id String @id @default(uuid())

	title String
	description String?
	amount Decimal @db.Decimal(10, 2)
	transactionDate DateTime
	dueDate DateTime

	paymentMethod PaymentMethod

	group Group @relation(fields: [groupId], references: [id])
	groupId String

	// Optional: when the category is deleted, the database sets categoryId to NULL ("Sem categoria" in the UI).
	category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
	categoryId String?


	// Required when paymentMethod is CREDIT, null otherwise (CHECK constraint). A card in use cannot be deleted.
	card Card? @relation(fields: [cardId], references: [id], onDelete: Restrict)
	cardId String?

	recurrence Recurrence? @relation(fields: [recurrenceId], references: [id])
	recurrenceId String?
	installmentNumber Int? // 1..N inside its recurrence

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

	@@index([dueDate, groupId])
	@@index([categoryId, groupId])
	@@index([paymentMethod, groupId])
	@@index([cardId, groupId])
	@@unique([recurrenceId, installmentNumber])
}

model Recurrence {
	id String @id @default(uuid())

	title String
	description String?
	amount Decimal @db.Decimal(10, 2) // Value of EACH installment, never the total
	paymentMethod PaymentMethod
	startDate DateTime // transactionDate of installment #1 (UTC midnight)
	totalInstallments Int? // null = never ends
	generatedCount Int @default(0) // How many installments were created so far
	canceledAt DateTime?

	// Optional: when the category is deleted, the series (and its future installments) have no category.
	category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
	categoryId String?

	// Required when paymentMethod is CREDIT, null otherwise (CHECK constraint).
	card Card? @relation(fields: [cardId], references: [id], onDelete: Restrict)
	cardId String?

	group Group @relation(fields: [groupId], references: [id])
	groupId String

	expenses Expense[]

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

	@@index([groupId])
}

model Income {
	id String @id @default(uuid())

	title String

	user User @relation(fields: [userId], references: [id])
	userId String

	group Group @relation(fields: [groupId], references: [id])
	groupId String

	date DateTime // Always the first date of Month
	amount Decimal @db.Decimal(10, 2)

	createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

// One-time code a user sends to the bot to link their WhatsApp. Only the SHA-256 hash is stored. Valid for 10 minutes.
model WhatsappLinkCode {
	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	userId String @id

	codeHash String @unique
	expiresAt DateTime
}

// Expense being built in the WhatsApp chat, waiting for "Salvar". One per user; expires after 10 minutes.
// cardId and categoryId are checked against the user's group again when saving.
model WhatsappDraft {
	id String @id @default(uuid())

	user User @relation(fields: [userId], references: [id], onDelete: Cascade)
	userId String @unique

	title String
	amount Decimal @db.Decimal(10, 2)
	date DateTime // transactionDate, UTC midnight
	paymentMethod PaymentMethod?
	cardId String?
	categoryId String?

	expiresAt DateTime
	createdAt DateTime @default(now())
}

// Messages already received from Meta, so a webhook retry is never processed twice. Also used for rate limits.
// Only the id and sender; never the message text. Rows older than 30 days are deleted.
model WhatsappMessage {
	id String @id // Meta message id ("wamid...")
	waId String

	createdAt DateTime @default(now())

	@@index([waId, createdAt])
}
